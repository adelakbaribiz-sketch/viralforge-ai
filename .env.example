# =============================================================================
# ViralForge AI — Environment Variables
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env` to git — it's in .gitignore.
# =============================================================================

# Core
NODE_ENV=development
LOG_LEVEL=info
AUTH_SECRET=change-me-in-prod-please-use-32-byte-hex

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://viralforge:viralforge@localhost:5432/viralforge?schema=public
DIRECT_DATABASE_URL=postgresql://viralforge:viralforge@localhost:5432/viralforge?schema=public
POSTGRES_PASSWORD=viralforge

# Redis 7 (BullMQ)
REDIS_URL=redis://localhost:6379

# S3 / MinIO (local) or R2/S3 (prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vf-assets
S3_ACCESS_KEY=viralforge
S3_SECRET_KEY=viralforge-secret
MINIO_ROOT_USER=viralforge
MINIO_ROOT_PASSWORD=viralforge-secret

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FREE=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=

# Web
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
API_PORT=4000

# AI Provider Keys — fill in only the ones you use.
# Missing keys fall back to providers that have keys (circuit breaker aware).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# TTS
ELEVENLABS_API_KEY=

# Video generation
RUNWAY_API_KEY=
PIKA_API_KEY=
LUMA_API_KEY=
KLING_API_KEY=
HAILUO_API_KEY=

# Stock (licensed)
STORYBLOCKS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090

# Bull Board (admin UI for queues) — internal only
BULL_BOARD_PORT=3010

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. AUTH_SECRET: 32-byte hex string. Generate with: openssl rand -hex 32
# 2. STRIPE_WEBHOOK_SECRET: from Stripe Dashboard → Developers → Webhooks
# 3. All AI provider keys: NEVER commit. Use a secret manager in prod (Vault, Doppler, etc.)
# 4. .env is in .gitignore. .env.example is the only env file that goes to git.
# 5. In production: use Kubernetes secrets or AWS Secrets Manager.
# 6. The worker process needs all the AI provider keys; the API only needs auth + stripe + db.
